<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/historyKeyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Słowo klucz"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary"/>

            <TextView
                android:id="@+id/historyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/status_bg_pending"/>
        </LinearLayout>

        <TextView
            android:id="@+id/historyTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-10-27 12:00"
            android:textSize="12sp"
            android:textColor="@color/onSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/historyContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Treść rozmowy w której wykryto słowo..."
            android:textSize="14sp"
            android:textColor="@color/onSurface"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
